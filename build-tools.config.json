{
  "cleanPaths": [
    "dist"
  ],
  "browser": {
    "enabled": true,
    "name": "joshuaHome"
  },
  "dist": {
    "main": "dist/main",
    "from": "assets/js/**/!(*.test).js",
    "to": "dist"
  },
  "images": {
    "enabled": false
  },
  "readme": {
    "enabled": false
  },
  "sass": {
    "enabled": false
  },
  "srcPath": "assets/js",
  "test": {
    "options": {
      "passWithNoTests": true,
      "testPathIgnorePatterns": [
        "/node_modules",
        "/projects"
      ],
      "transformIgnorePatterns": [
        "/node_modules/(?!marked/)"
      ]
    },
    "path": "assets/js",
    "watch": "assets/js/**/*.js"
  }
}
