{
  "name": "website",
  "version": "0.0.0",
  "description": "Personal website",
  "main": "gulpfile.js",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "htmldocs": "jsdoc -R MAIN.md -c ./.jsdoc.conf.js -d docs",
    "readme": "gulp readme",
    "resolutions": "npx npm-force-resolutions",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "author": "Joshua Heagle",
  "license": "GNU",
  "peerDependencies": {
    "gulp-imagemin": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "gulp-imagemin": {
      "optional": true
    }
  },
  "dependencies": {
    "json-dom": "github:jheagle/JSON-DOM",
    "json-dom-components": "github:jheagle/json-dom-components",
    "matrix-dom": "github:jheagle/matrix-DOM",
    "si-funciona": "^2.8.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "del": "^7.1.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "9.0.0",
    "gulp-imagemin": "github:jheagle/gulp-imagemin#common-js-compatibility",
    "jest": "^29.7.0",
    "js-build-tools": "^6.4.1",
    "pseudo-dom": "github:jheagle/pseudo-dom",
    "signal-exit": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jheagle/website"
  },
  "keywords": [
    "gulp",
    "sass",
    "browsersync",
    "json-dom",
    "portfolio"
  ],
  "bugs": {
    "url": "https://github.com/jheagle/website/issues"
  },
  "homepage": "https://joshuaheagle.com",
  "allowScripts": {
    "gifsicle@5.3.0": true,
    "mozjpeg@8.0.0": true,
    "optipng-bin@7.0.1": true,
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "unrs-resolver": false
  },
  "standard": {
    "env": [
      "jest"
    ]
  }
