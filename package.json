{
  "name": "website",
  "version": "0.0.0",
  "description": "Personal website",
  "main": "gulpfile.js",
  "scripts": {
    "build": "gulp build && npm run build:fonts && npm run build:vendor && npm run blog:build && npm run books:build && npm run build:css && npm run build:fingerprint",
    "dev": "gulp",
    "htmldocs": "jsdoc -R MAIN.md -c ./.jsdoc.conf.js -d docs",
    "readme": "gulp readme",
    "resolutions": "npx npm-force-resolutions",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "build:css": "tailwindcss -i assets/tailwind/site.css -o browser/tailwind/site.css --minify",
    "build:fonts": "node scripts/copy-fonts.mjs",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build:library": "node scripts/build-library-database.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:fingerprint": "node scripts/fingerprint.cjs",
    "build:sitemap": "node scripts/sitemap.cjs",
    "blog:import": "node scripts/blog/blog.cjs import",
    "blog:export": "node scripts/blog/blog.cjs export",
    "blog:build": "node scripts/blog/blog.cjs build && npm run build:sitemap && npm run build:fingerprint",
    "books:import": "node scripts/books/books.cjs import",
    "books:build": "node scripts/books/books.cjs build && npm run build:sitemap && npm run build:fingerprint",
    "compare:browsers": "node scripts/compare-browsers.cjs",
    "watch:css": "tailwindcss -i assets/tailwind/site.css -o browser/tailwind/site.css --watch",
    "lint": "gulp lint",
    "images:responsive": "node scripts/responsive-images.mjs"
  },
  "author": "Joshua Heagle",
  "license": "GNU",
  "peerDependencies": {
    "gulp-imagemin": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "gulp-imagemin": {
      "optional": true
    }
  },
  "dependencies": {
    "collect-your-stuff": "^2.4.0",
    "json-dom": "github:jheagle/JSON-DOM",
    "json-dom-components": "github:jheagle/json-dom-components",
    "json-fs-query": "^3.1.4",
    "matrix-dom": "github:jheagle/matrix-DOM",
    "pseudo-dom": "^1.2.0",
    "si-funciona": "^2.9.1",
    "title-switcher": "^2.2.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "browser-sync": "^3.0.4",
    "del": "^7.1.0",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "9.0.0",
    "gulp-imagemin": "github:jheagle/gulp-imagemin#common-js-compatibility",
    "jest": "^29.7.0",
    "js-build-tools": "^8.0.0",
    "marked": "^16.4.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "signal-exit": "^4.1.0",
    "tailwindcss": "^4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jheagle/website"
  },
  "keywords": [
    "gulp",
    "tailwind",
    "browsersync",
    "json-dom",
    "portfolio"
  ],
  "bugs": {
    "url": "https://github.com/jheagle/website/issues"
  },
  "homepage": "https://joshuaheagle.com",
  "allowScripts": {
    "gifsicle@5.3.0": true,
    "mozjpeg@8.0.0": true,
    "optipng-bin@7.0.1": true,
    "@parcel/watcher": false,
    "core-js": false,
    "core-js-pure": false,
    "unrs-resolver": false
  },
  "standard": {
    "env": [
      "jest"
    ]
  }
}
